#, no-wrap
msgid "First-Deployment Security Checklist"
msgstr ""

#. type: Bullet: '1. '
#: docs/guide/security.md:129
msgid "Install and initialize pass + GPG; all secrets into pass only"
msgstr ""

#. type: Bullet: '2. '
