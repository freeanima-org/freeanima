"user: good morning\n"
"assistant: morning ☀️\n"
"user: going to eat\n"
"assistant: what are you having\n"
"user: going to eat\n"
msgstr ""
"user: good morning\n"
"assistant: morning ☀️\n"
"user: going to eat\n"
"assistant: what are you having\n"
"user: going to eat\n"

