{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./app/src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "app/src/**/*.ts",
    "app/src/**/*.tsx",
    "server/**/*.ts",
    "shared/**/*.ts",
    "shared/**/*.json",
    "build.ts",
    "dev.ts",
    "prepare-sidecar.ts",
    "build-tauri.ts",
    "../../types/**/*.d.ts"
  ],
  "exclude": ["shell/target/**", "shell/src-tauri/resources/**"]
}
