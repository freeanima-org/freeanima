msgid "Included in default conversation toolsets when registered."
msgstr "注册后包含在默认对话 toolset 中。"

#. type: Title ##
#: docs/concepts/notifications.md:74
#, no-wrap
msgid "SAP (read)"
msgstr "SAP（读）"

#. type: Bullet: '- '
#: docs/concepts/notifications.md:79
msgid ""
"`notification.list` — requires `recipient_kind` + optional `recipient_id`"
msgstr "`notification.list` — 需要 `recipient_kind` + 可选 `recipient_id`"

#. type: Bullet: '- '
#: docs/concepts/notifications.md:79
msgid "`notification.markRead`"
msgstr "`notification.markRead`"

#. type: Bullet: '- '
#: docs/concepts/notifications.md:79
msgid "`notification.recipients` — configured subject ids for UI tabs"
msgstr "`notification.recipients` — UI 标签页用的已配置主体 id"

#. type: Plain text
#: docs/concepts/notifications.md:81
msgid "No SAP create RPC in v1; writes are Hub-internal + tools."
msgstr "v1 无 SAP 创建 RPC；写入由 Hub 内部 + 工具完成。"

