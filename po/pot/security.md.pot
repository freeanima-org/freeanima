msgstr ""

#. type: Bullet: '2. '
#: docs/guide/security.md:147
msgid ""
"Open Shell `/vault`; set User master password; migrate secrets from legacy "
"pass if needed"
msgstr ""

#. type: Bullet: '3. '
#: docs/guide/security.md:147
