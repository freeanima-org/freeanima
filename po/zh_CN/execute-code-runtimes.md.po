msgid ""
"```yaml\n"
"execute_code:\n"
"  default_runtime: bun\n"
"  runtimes:\n"
"    nodejs:\n"
"      enabled: true\n"
"    python:\n"
"      enabled: true\n"
"      command: python3\n"
"    deno:\n"
"      enabled: false\n"
"```\n"
msgstr ""
"```yaml\n"
"execute_code:\n"
"  default_runtime: bun\n"
"  runtimes:\n"
"    nodejs:\n"
"      enabled: true\n"
"    python:\n"
"      enabled: true\n"
"      command: python3\n"
"    deno:\n"
"      enabled: false\n"
"      command: deno\n"
"```\n"

