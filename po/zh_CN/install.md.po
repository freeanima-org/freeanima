"git clone https://github.com/freeanima-org/freeanima.git\n"
"cd freeanima\n"
"bun install\n"

#. type: Plain text
#: docs/guide/install.md:66
msgid ""
"Install prefix 只需要 **一个** `anima` 文件。Do not unpack into a git "
"checkout. Ensure `~/.anima/bin` is on `PATH`."
msgstr ""

#. type: Plain text
#: docs/guide/install.md:68
msgid "Manual unpack (same layout as the installer):"
msgstr ""

#. type: Fenced code block (bash)
#: docs/guide/install.md:69
#, no-wrap
msgid ""
"mkdir -p ~/.anima/standalone && cd ~/.anima/standalone\n"
"tar -xzf /path/to/anima-linux-x64.tar.gz\n"
"mkdir -p ~/.anima/bin && ln -sf \"$PWD/anima\" ~/.anima/bin/anima\n"
