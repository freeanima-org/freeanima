{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": false,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "bun-plugin-dir-import"],
    "paths": {
      "@freeanima/shared/*": ["./packages/shared/*"],
      "@freeanima/kernel": ["./packages/kernel/index.ts"],
      "@freeanima/kernel/*": ["./packages/kernel/*"],
      "@freeanima/core/*": ["./packages/core/*"],
      "@freeanima/engine": ["./packages/engine/index.ts"],
      "@freeanima/engine/*": ["./packages/engine/*"],
      "@freeanima/capabilities/*": ["./packages/capabilities/*"],
      "@freeanima/features/*": ["./packages/features/*"],
      "@freeanima/server": ["./packages/server/index.ts"],
      "@freeanima/server/*": ["./packages/server/*"],
      "@freeanima/cli/*": ["./packages/cli/*"],
      "@freeanima/ui-kit": ["./packages/ui-kit/index.ts"],
      "@freeanima/ui-kit/*": ["./packages/ui-kit/*"],
      "@freeanima/portal-sdk": ["./packages/portal-sdk/index.ts"],
      "@freeanima/portal-sdk/*": ["./packages/portal-sdk/*"],
      "@freeanima/ui-features/*": ["./packages/ui-features/*"],
      "@freeanima/app-frame/*": ["./packages/app-frame/*"],
      "@freeanima/portal/*": ["./packages/portal/*"]
    }
  }
}
