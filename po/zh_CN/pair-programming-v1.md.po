#. type: Plain text
#: docs/designs/pair-programming-v1.md:194
msgid "## IV. Global Search"
msgstr "## 四、全局搜索"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:196
msgid "### API"
msgstr "### API"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:212
#, no-wrap
msgid ""
"```\n"
"POST /api/studio/search\n"
"Body: { query: string, path: string }\n"
"Response: {\n"
"  results: [\n"
"    {\n"
"      \"file\": \"src/main.ts\",\n"
"      \"line\": 42,\n"
"      \"column\": 8,\n"
"      \"content\": \"  const x = foo()\",\n"
"      \"match\": \"foo\"\n"
"    }\n"
"  ]\n"
"}\n"
"```\n"
msgstr ""
"```\n"
"POST /api/studio/search\n"
