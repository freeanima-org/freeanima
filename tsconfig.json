{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "types/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "messages/**/*.json",
    "src/satellites/companion/shared/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/.turbo/**",
    "src/app/cli/publish/**",
    "src/app/shell/mobile/android/**",
    "scripts/codemod-freeanima-imports.ts"
  ]
}
