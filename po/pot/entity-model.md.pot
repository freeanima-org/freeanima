#. type: Title ##
#: docs/concepts/entity-model.md:173
#, no-wrap
msgid "Vault module (Estate)"
msgstr ""

#. type: Plain text
#: docs/concepts/entity-model.md:176
msgid ""
"Encrypted credentials in two libraries (**User** + **Agent**), ECS "
"components `vault_config` + `vault_item`:"
msgstr ""

#. type: Plain text
#: docs/concepts/entity-model.md:181
#, no-wrap
