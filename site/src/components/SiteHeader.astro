---
import { getNavLinks, siteName } from "../lib/site.ts";

interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const navLinks = getNavLinks();

function isActive(href: string): boolean {
  if (href === "/") {
    return pathname === "/" || pathname === "";
  }
  if (href.startsWith("/docs")) {
    return pathname === "/docs" || pathname.startsWith("/docs/");
  }
  return false;
}
---

<header class:list={["site-header", embedded && "site-header--embedded"]}>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/">
      <img class="site-header__logo" src="/favicon.png" width="20" height="20" alt="" />
      {siteName}
    </a>
    <nav class="site-header__nav" aria-label="站点导航">
      {
        navLinks.map((link) => (
          <a
            class:list={["site-header__link", isActive(link.href) && "site-header__link--active"]}
            href={link.href}
            target={"external" in link && link.external ? "_blank" : undefined}
            rel={"external" in link && link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.875rem clamp(1.25rem, 4vw, 2rem);
  }

  .site-header__logo {
    display: block;
    flex-shrink: 0;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-header__brand:hover {
    color: #fff;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem 1.25rem;
  }

  .site-header__link {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .site-header__link:hover,
  .site-header__link--active {
    color: var(--color-text);
  }

  @media (max-width: 480px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-header__nav {
      justify-content: flex-start;
    }
  }
</style>
