#. type: Title ##
#: docs/sap/satellite-guide.md:115
#, no-wrap
msgid "Minimal SAP client"
msgstr ""

#. type: Plain text
#: docs/sap/satellite-guide.md:118
msgid ""
"Use `runSapTransport` or `createSatelliteHub` from `@freeanima/sap-contract`:"
msgstr ""

#. type: Fenced code block (typescript)
#: docs/sap/satellite-guide.md:119
#, no-wrap
msgid ""
"import { createSatelliteHub, fileSapInstanceStore } from \"@freeanima/shared/sap-contract\";\n"
"\n"
"const hub = createSatelliteHub({\n"
"  appId: \"my-app\",\n"
"  hubUrl: process.env.FREEANIMA_URL ?? \"http://127.0.0.1:2658\",\n"
"  httpUrl: `http://127.0.0.1:${process.env.SATELLITE_PORT ?? 4173}`,\n"
"  instanceStore: fileSapInstanceStore(\"/path/to/instance.json\"),\n"
"  relay: false,\n"
"  tools: [],\n"
"  onConnected: async () => {\n"
"    /* optional conversation.create — connect does not auto-create conversations */\n"
"  },\n"
"});\n"
msgstr ""

#. type: Plain text
#: docs/sap/satellite-guide.md:136
#, no-wrap
msgid "**Machine strategy (companion):** omit `instance_id` on first connect; Hub assigns a 3-char id and returns it in `connected.instance_id`. Persist via `SapInstanceStore.save`.\n"
msgstr ""

#. type: Plain text
#: docs/sap/satellite-guide.md:138
#, no-wrap
msgid "**Singleton strategy (chat):** pass fixed `instance_id` (or `instanceId` option on `getBundledSapStreamClient`); Hub auto-provisions on first sight.\n"
msgstr ""

#. type: Plain text
#: docs/sap/satellite-guide.md:140
msgid ""
"Browser UI on Type B relay satellites uses `createSapRelayBrowserClient()` "
"instead of talking to Hub directly."
msgstr ""

#. type: Plain text
#: docs/sap/satellite-guide.md:142
msgid ""
"Transport handles WebSocket open, `connect` handshake, heartbeat, and "
"reconnect with exponential backoff."
msgstr ""

