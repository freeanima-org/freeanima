{
  "name": "@freeanima/satellite-companion",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun scripts/ensure-fbx2gltf.ts",
    "setup:fbx": "bun scripts/ensure-fbx2gltf.ts --strict",
    "dev": "bun dev.ts",
    "build": "bun build.ts",
    "build:sidecar": "bun prepare-sidecar.ts",
    "build:tauri": "bun build-tauri.ts",
    "build:windows": "bun build-tauri.ts --target x86_64-pc-windows-gnu",
    "build:windows:installer": "COMPANION_BUILD_PROFILE=release bun build-tauri.ts --target x86_64-pc-windows-gnu",
    "build:macos": "bun build-tauri.ts --target aarch64-apple-darwin",
    "build:macos:intel": "bun build-tauri.ts --target x86_64-apple-darwin",
    "build:macos:release": "COMPANION_BUILD_PROFILE=release bun build-tauri.ts --target aarch64-apple-darwin",
    "build:macos:intel:release": "COMPANION_BUILD_PROFILE=release bun build-tauri.ts --target x86_64-apple-darwin",
    "start": "bun build.ts && bun server/index.ts"
  },
  "dependencies": {
    "@freeanima/sap-contract": "workspace:*",
    "@pixiv/three-vrm": "^3.4.2",
    "@pixiv/three-vrm-animation": "^3.4.2",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "fbx2vrma-converter": "^1.0.2",
    "react": "19",
    "react-dom": "19",
    "three": "^0.175.0",
    "zod": "catalog:",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.175.0",
    "bun-plugin-tailwind": "^0.1.2",
    "daisyui": "^5.5.20",
    "tailwindcss": "^4.3.0"
  }
}
