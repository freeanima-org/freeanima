msgstr ""

#. type: Plain text
#: docs/designs/desktop-companion.md:116
msgid "### Desktop → Agent (Probe Data)"
msgstr ""

#. type: Plain text
#: docs/designs/desktop-companion.md:134
#, no-wrap
msgid ""
"```json\n"
"{\n"
"  \"type\": \"sensor\",\n"
"  \"timestamp\": \"2026-05-20T12:15:00+08:00\",\n"
"  \"payload\": {\n"
"    \"partner_active\": true,\n"
"    \"idle_seconds\": 30,\n"
"    \"active_window\": {\n"
"      \"title\": \"main.rs - Visual Studio Code\",\n"
"      \"process\": \"Code.exe\",\n"
"      \"category\": \"code\"\n"
"    },\n"
"    \"mouse_position\": { \"x\": 960, \"y\": 540 },\n"
"    \"screen_size\": { \"width\": 1920, \"height\": 1080 }\n"
"  }\n"
"}\n"
"```\n"
msgstr ""

#. type: Plain text
#: docs/designs/desktop-companion.md:136
msgid "### Desktop → Agent (Interaction Events)"
msgstr ""

#. type: Plain text
#: docs/designs/desktop-companion.md:148
#, no-wrap
msgid ""
"```json\n"
"{\n"
"  \"type\": \"interaction\",\n"
"  \"timestamp\": \"...\",\n"
"  \"payload\": {\n"
"    \"action\": \"click\" | \"drag\" | \"hover\",\n"
"    \"target\": \"body\" | \"head\" | \"ear\",\n"
"    \"position\": { \"x\": 1000, \"y\": 600 }\n"
"  }\n"
"}\n"
"```\n"
msgstr ""

#. type: Plain text
#: docs/designs/desktop-companion.md:150
msgid "### Agent → Desktop (Action Commands)"
msgstr ""

#. type: Plain text
#: docs/designs/desktop-companion.md:166
#, no-wrap
msgid ""
"```json\n"
"{\n"
"  \"type\": \"action\",\n"
"  \"payload\": {\n"
"    \"action\": \"move_to\" | \"tween_to\" | \"set_expression\" | \"play_animation\" | \"show_bubble\" | \"open_webview\",\n"
"    \"params\": {\n"
"      \"position\": { \"x\": 100, \"y\": 300 },\n"
"      \"expression\": \"happy\",\n"
"      \"animation\": \"wave\",\n"
"      \"text\": \"Time for a break\",\n"
"      \"duration_ms\": 5000\n"
"    }\n"
"  }\n"
"}\n"
"```\n"
msgstr ""

#. type: Plain text
#: docs/designs/desktop-companion.md:168
msgid "### Agent → Desktop (Mode Switch)"
msgstr ""

#. type: Plain text
#: docs/designs/desktop-companion.md:178
#, no-wrap
msgid ""
"```json\n"
"{\n"
"  \"type\": \"mode\",\n"
"  \"payload\": {\n"
"    \"mode\": \"active\" | \"quiet\" | \"sleep\" | \"away\",\n"
"    \"idle_behavior\": \"low_frequency_wander\" | \"still\" | \"sit_on_window\"\n"
"  }\n"
"}\n"
"```\n"
msgstr ""

