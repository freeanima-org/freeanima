---
import SiteHeader from "../components/SiteHeader.astro";
import type { SiteLocale } from "../lib/site.ts";
import { getSiteMeta } from "../lib/site.ts";
import "../styles/global.css";
import "../styles/landing.css";

interface Props {
  locale?: SiteLocale;
  title?: string;
  description?: string;
}

const locale = Astro.props.locale ?? "en";
const fallback = getSiteMeta();
const title = Astro.props.title ?? fallback.siteTitle;
const description = Astro.props.description ?? fallback.siteDescription;
const htmlLang = locale === "zh-cn" ? "zh-CN" : "en";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <SiteHeader locale={locale} />
    <main class="landing">
      <slot />
    </main>
  </body>
</html>
