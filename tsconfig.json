{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@admin/*": ["./features/console/ui/admin/*"],
      "@paraglide/messages": ["./messages/paraglide/messages.js"],
      "@paraglide/runtime": ["./messages/paraglide/runtime.js"],
      "@/*": ["./satellites/companion/app/src/*"],
      "@shared/*": ["./satellites/companion/shared/*"],
      "@freeanima/capabilities-satellite": ["./capabilities/satellite/src/index.ts"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "kernel/**/*.ts",
    "shared/**/*.ts",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "core/**/*.ts",
    "runtime/**/*.ts",
    "platform/**/*.ts",
    "capabilities/**/*.ts",
    "satellites/**/*.ts",
    "app/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "messages/**/*.json",
    "satellites/companion/shared/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/.turbo/**",
    "app/cli/publish/**",
    "satellites/pair-programming/app/**",
    "satellites/companion/app/**",
    "shared/sap-contract/**",
    "frontend/shell-ui/app/**",
    "frontend/shell-ui/src/**",
    "frontend/shell-ui/types/**"
  ]
}
