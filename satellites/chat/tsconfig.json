{
  "extends": "../../tsconfig.composite.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": ".tsout",
    "paths": {
      "@chat/*": ["./app/src/*"]
    }
  },
  "include": ["app/src/**/*.ts", "app/src/**/*.tsx", "src/**/*.ts", "../../types/**/*.d.ts"],
  "exclude": ["**/*.test.ts", "dist/**"],
  "references": [{ "path": "../../packages/ui-kit" }]
}
