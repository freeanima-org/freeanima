---
import SiteHeader from "../components/SiteHeader.astro";
import { getSiteMeta } from "../lib/site.ts";
// oxlint-disable-next-line import/no-unassigned-import -- Astro side-effect stylesheet
import "../styles/global.css";
// oxlint-disable-next-line import/no-unassigned-import -- Astro side-effect stylesheet
import "../styles/landing.css";

interface Props {
  title?: string;
  description?: string;
}

const fallback = getSiteMeta();
const title = Astro.props.title ?? fallback.siteTitle;
const description = Astro.props.description ?? fallback.siteDescription;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <SiteHeader />
    <main class="landing">
      <slot />
    </main>
  </body>
</html>
