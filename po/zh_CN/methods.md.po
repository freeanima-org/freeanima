"    Terminals[terminal-session]\n"
"    SatMgr[SatelliteManager]\n"
"  end\n"
"  Client -->|req| Router\n"
"  Router --> Sessions\n"
"  Router --> Runtime\n"
"  Router --> Terminals\n"
