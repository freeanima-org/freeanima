{
  "name": "freeanima",
  "version": "0.8.2",
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@inlang/plugin-m-function-matcher": "^2.2.9",
    "@inlang/plugin-message-format": "^4.4.0",
    "@splicemood/lcov-to-cobertura": "^0.1.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "@typescript/native-preview": "^7.0.0-dev.20260630.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.72.0",
    "stylelint": "^17.14.0"
  },
  "bin": {
    "anima": "./app/cli/src/cli.ts"
  },
  "description": "逸灵风 Free Anima (TypeScript)",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run dep-check && bun run stylelint && bun run format && bun run test:changed",
    "dep-check": "bun scripts/check-layer-deps.ts && bun scripts/check-package-cycles.ts && bun scripts/check-no-db-execute.ts && bun run docs:i18n:check && bun run i18n:docs:check:strict",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "stylelint": "stylelint \"packages/**/app/src/**/*.css\" \"packages/ui-kit/src/**/*.css\" \"satellites/**/app/src/**/*.css\" \"platform/admin-frontend/app/src/**/*.css\" \"app/desktop/**/src/**/*.css\" \"app/web/**/src/**/*.css\"",
    "stylelint:fix": "stylelint --fix \"packages/**/app/src/**/*.css\" \"packages/ui-kit/src/**/*.css\" \"satellites/**/app/src/**/*.css\" \"platform/admin-frontend/app/src/**/*.css\" \"app/desktop/**/src/**/*.css\" \"app/web/**/src/**/*.css\"",
    "typecheck": "bunx tsgo -b tsconfig.check.json",
    "build:cli": "bun scripts/build-cli.ts",
    "install:cli:local": "bun scripts/install-cli-local.ts",
    "build:shell-ui": "bun run --filter @freeanima/shell-ui build",
    "dev:admin": "bun run dev:web",
    "dev:web": "bun run --filter @freeanima/app-web dev",
    "publish:cli": "bun scripts/build-cli.ts && cd app/cli/publish && bun pm pack && bun publish --access public",
    "test": "bun scripts/run-all-tests.ts",
    "test:unit": "bun scripts/run-unit-tests.ts",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "test:changed": "bun scripts/run-unit-tests.ts --changed",
    "paraglide:compile": "cd site && bun run paraglide",
    "i18n:po4a": "bun scripts/i18n-po4a.ts",
    "i18n:messages:master": "bun scripts/gen-messages-po4a-master.ts",
    "i18n:messages:compile": "bun scripts/compile-messages-from-po4a.ts",
    "i18n:messages:bootstrap-po": "bun scripts/bootstrap-messages-po.ts",
    "i18n:docs:cfg": "bun scripts/gen-po4a-cfg.ts",
    "i18n:docs:migrate-layout": "bun scripts/migrate-docs-po-layout.ts",
    "docs:i18n:check": "bun scripts/check-docs-i18n.ts",
    "docs:check-frontmatter": "bun scripts/check-docs-i18n.ts",
    "i18n:docs:generated:check": "bun scripts/check-generated-docs-i18n.ts",
    "i18n:docs:english:check": "bun scripts/check-po-english-msgstr.ts",
    "i18n:docs:check": "bun scripts/check-po-health.ts",
    "i18n:docs:check:strict": "bun scripts/check-po-health.ts --strict",
    "memory:sample": "bun scripts/memory-sample.ts",
    "migrate:tasks": "bun scripts/archive/migrate-tasks-to-entities.ts",
    "migrate:email": "bun scripts/archive/migrate-email-to-entities.ts",
    "recover:tasks": "bun scripts/archive/recover-tasks-from-message-history.ts",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "coverage:cobertura": "bun scripts/run-tests.ts --coverage && bun scripts/lcov-to-cobertura.ts",
    "coverage:check-threshold": "bun scripts/check-coverage-threshold.ts",
    "service": "bun app/cli/src/cli.ts service",
    "anima": "bun app/cli/src/cli.ts",
    "dev:windows": "bun run --filter @freeanima/app-desktop dev:windows",
    "package:windows": "bun run --filter @freeanima/app-desktop package:windows",
    "debug:android": "bun run --filter @freeanima/app-mobile android:debug",
    "link:global": "mkdir -p \"${BUN_INSTALL:-$HOME/.bun}/bin\" && ln -sf \"$PWD/app/cli/src/cli.ts\" \"${BUN_INSTALL:-$HOME/.bun}/bin/anima\" && chmod +x app/cli/src/cli.ts",
    "prepare": "husky"
  },
  "patchedDependencies": {
    "fbx2vrma-converter@1.0.2": "patches/fbx2vrma-converter@1.0.2.patch"
  },
  "overrides": {
    "@sinclair/typebox": "^0.34.49"
  },
  "trustedDependencies": [
    "cpu-features",
    "esbuild",
    "protobufjs"
  ],
  "workspaces": {
    "packages": [
      "kernel",
      "packages/*",
      "capabilities/*",
      "satellites/*",
      "app/*",
      "platform/admin-api",
      "platform/admin-contract",
      "platform/admin-frontend",
      "site",
      "tests",
      "runtime",
      "core",
      "platform"
    ],
    "catalog": {
      "@sinclair/typebox": "^0.34.49",
      "@tailwindcss/vite": "^4.3.0",
      "@types/bun": "^1.3.14",
      "@types/node": "^26.0.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@typescript/native-preview": "^7.0.0-dev.20260602.1",
      "@radix-ui/react-checkbox": "^1.3.2",
      "@radix-ui/react-collapsible": "^1.1.11",
      "@radix-ui/react-dialog": "^1.1.14",
      "@radix-ui/react-dropdown-menu": "^2.1.15",
      "@radix-ui/react-label": "^2.1.7",
      "@radix-ui/react-scroll-area": "^1.2.9",
      "@radix-ui/react-select": "^2.2.5",
      "@radix-ui/react-separator": "^1.1.7",
      "@radix-ui/react-slot": "^1.2.3",
      "@radix-ui/react-switch": "^1.2.5",
      "@radix-ui/react-tabs": "^1.1.12",
      "@radix-ui/react-tooltip": "^1.2.7",
      "@vitejs/plugin-react": "^4.7.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-kit": "^1.0.0-rc.4",
      "drizzle-orm": "^1.0.0-rc.4",
      "lucide-react": "^0.525.0",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "tailwind-merge": "^3.3.1",
      "tailwindcss": "^4.3.1",
      "tailwindcss-animate": "^1.0.7",
      "typescript": "^6.0.3",
      "vite": "^6.4.1",
      "zod": "^4.4.3",
      "zustand": "^5.0.14"
    }
  }
}
