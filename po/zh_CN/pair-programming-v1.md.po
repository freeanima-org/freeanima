"Response: {\n"
"  results: [\n"
"    {\n"
"      file: \"src/main.ts\",\n"
"      line: 42,\n"
"      column: 8,\n"
"      content: \"  const x = foo()\",\n"
"      match: \"foo\"\n"
"    }\n"
"  ]\n"
"}\n"
"```\n"

