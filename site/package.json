{
  "name": "@freeanima/site",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "sync-install": "cp ../scripts/install.sh public/install",
    "sync-firefox-updates": "bun ../scripts/sync-firefox-extension-updates.ts",
    "predev": "bun run sync-install && bun run sync-firefox-updates",
    "dev": "astro dev",
