{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@admin/*": ["./platform/admin-frontend/app/src/*"],
      "@/*": ["./satellites/companion/app/src/*"],
      "@shared/*": ["./satellites/companion/shared/*"],
      "@freeanima/capabilities-satellite": ["./capabilities/satellite/src/index.ts"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "kernel/**/*.ts",
    "packages/**/*.ts",
    "core/**/*.ts",
    "runtime/**/*.ts",
    "platform/**/*.ts",
    "capabilities/**/*.ts",
    "satellites/**/*.ts",
    "app/**/*.ts",
    "platform/admin-frontend/app/**/*.ts",
    "platform/admin-frontend/app/**/*.tsx",
    "platform/admin-frontend/app/index.html",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "messages/**/*.json",
    "satellites/companion/shared/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/.turbo/**",
    "app/cli/publish/**",
    "satellites/pair-programming/app/**",
    "satellites/chat/app/**",
    "satellites/companion/app/**",
    "packages/sap-contract/**",
    "packages/shell-ui/**"
  ]
}
