{
  "name": "freeanima",
  "version": "0.8.5",
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@inlang/paraglide-js": "^2.20.2",
    "@inlang/plugin-m-function-matcher": "^2.2.9",
    "@inlang/plugin-message-format": "^4.4.0",
    "@splicemood/lcov-to-cobertura": "^0.1.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^1.0.0-rc.4",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "bin": {
    "anima": "./src/app/cli/cli.ts"
  },
  "description": "逸灵风 Free Anima (TypeScript)",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "workspaces": [
    "site"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run import-depth && bun run stylelint && bun run format && bun run test:changed",
    "import-depth": "bun scripts/check-import-depth.ts",
    "typecheck": "bunx tsgo -p tsconfig.json",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "stylelint": "stylelint \"src/frontend/**/spa/**/*.css\" \"src/frontend/**/lib/**/*.css\" \"src/features/**/ui/**/*.css\" \"src/satellites/**/spa/**/*.css\" \"src/app/shell/desktop/**/spa/**/*.css\" \"src/app/shell/web/**/spa/**/*.css\"",
    "stylelint:fix": "stylelint --fix \"src/frontend/**/spa/**/*.css\" \"src/frontend/**/lib/**/*.css\" \"src/features/**/ui/**/*.css\" \"src/satellites/**/spa/**/*.css\" \"src/app/shell/desktop/**/spa/**/*.css\" \"src/app/shell/web/**/spa/**/*.css\"",
    "brand:icons": "bun scripts/generate-brand-icons.ts",
    "build:cli:executable": "bun scripts/build-cli-executable.ts",
    "setup:fbx": "bun src/satellites/companion/scripts/ensure-fbx2gltf.ts",
    "db:generate": "bunx drizzle-kit generate --config src/core/drizzle.config.ts",
    "db:migrate": "bunx drizzle-kit migrate --config src/core/drizzle.config.ts",
    "build:shell-ui": "bun src/frontend/shell-ui/build.ts",
    "dev:service": "bun run service start --foreground",
    "dev:console": "bun run dev:web",
    "dev:web": "bun run paraglide:compile && cd src/app/shell/web && vite",
    "build:web": "bun run paraglide:compile && cd src/app/shell/web && vite build && bun ../../../../scripts/gen-build-meta.ts --component web --channel prod --out dist/build-meta.json",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test src --pass-with-no-tests",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "test:changed": "bun test src --pass-with-no-tests --changed",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./messages/paraglide",
    "i18n:po4a": "bun scripts/i18n-po4a.ts",
    "i18n:messages:master": "bun scripts/gen-messages-po4a-master.ts",
    "i18n:messages:compile": "bun scripts/compile-messages-from-po4a.ts",
    "i18n:messages:bootstrap-po": "bun scripts/bootstrap-messages-po.ts",
    "i18n:docs:cfg": "bun scripts/gen-po4a-cfg.ts",
    "i18n:docs:migrate-layout": "bun scripts/migrate-docs-po-layout.ts",
    "docs:i18n:check": "bun scripts/check-docs-i18n.ts",
    "docs:check-frontmatter": "bun scripts/check-docs-i18n.ts",
    "i18n:docs:generated:check": "bun scripts/check-generated-docs-i18n.ts",
    "i18n:docs:english:check": "bun scripts/check-po-english-msgstr.ts",
    "i18n:docs:check": "bun scripts/check-po-health.ts",
    "i18n:docs:check:strict": "bun scripts/check-po-health.ts --strict",
    "i18n:check:all": "bun run docs:i18n:check && bun run i18n:docs:check:strict && bun scripts/check-paraglide-messages.ts && bun run i18n:docs:generated:check",
    "memory:sample": "bun scripts/memory-sample.ts",
    "migrate:tasks": "bun scripts/archive/migrate-tasks-to-entities.ts",
    "migrate:email": "bun scripts/archive/migrate-email-to-entities.ts",
    "recover:tasks": "bun scripts/archive/recover-tasks-from-message-history.ts",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "coverage:cobertura": "bun scripts/run-tests.ts --coverage && bun scripts/lcov-to-cobertura.ts",
    "coverage:check-threshold": "bun scripts/check-coverage-threshold.ts",
    "service": "bun src/app/cli/cli.ts service",
    "anima": "bun src/app/cli/cli.ts",
    "dev:windows": "cd src/app/shell/desktop && bun dev-electron.ts",
    "package:windows": "cd src/app/shell/desktop && DESKTOP_SHELL_BUILD_PROFILE=release bun build-electron.ts --platform win",
    "build:mobile": "bun run build:web && bun scripts/sync-mobile-android-version.ts && bun scripts/sync-mobile-www.ts",
    "build:mobile:debug": "FREEANIMA_WEB_SKIP_PWA=1 bun run build:web && MOBILE_DEBUG=1 bun scripts/sync-mobile-www.ts",
    "debug:android": "cd src/app/shell/mobile && MOBILE_DEBUG=1 bash scripts/run-android.sh",
    "link:global": "mkdir -p \"${BUN_INSTALL:-$HOME/.bun}/bin\" && ln -sf \"$PWD/src/app/cli/cli.ts\" \"${BUN_INSTALL:-$HOME/.bun}/bin/anima\" && chmod +x src/app/cli/cli.ts",
    "prepare": "husky"
  },
  "patchedDependencies": {
    "fbx2vrma-converter@1.0.2": "patches/fbx2vrma-converter@1.0.2.patch"
  },
  "overrides": {
    "@sinclair/typebox": "^0.34.50"
  },
  "trustedDependencies": [
    "cpu-features",
    "esbuild",
    "protobufjs"
  ],
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@clack/prompts": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/tokenizers": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@node-rs/jieba": "^2.0.1",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sinclair/typebox": "^0.34.50",
    "@tanstack/react-router": "^1.170.17",
    "@xterm/addon-fit": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "discord.js": "^14.26.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "edge-tts-universal": "^1.4.0",
    "fbx2vrma-converter": "^1.0.2",
    "highlight.js": "^11.11.1",
    "imapflow": "^1.4.6",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "tiktoken": "^1.0.22",
    "ws": "^8.21.0",
    "xterm": "^5.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
