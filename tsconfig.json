{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "types/**/*.d.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/ui-features/companion/shared/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/dist-types/**",
    "**/.turbo/**",
    "scripts/codemod-freeanima-imports.ts",
    "packages/portal/extension/**",
    "**/src-tauri/**"
  ]
}
