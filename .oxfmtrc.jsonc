{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "ignorePatterns": [
    "bun.lock",
    ".cursor/plans/**",
    "**/dist/**",
    "**/electron-dist/**",
    "**/coverage/**",
    "packages/features/habitat/ui/habitat/routeTree.gen.ts",
    "CHANGELOG.md",
  ],
  "overrides": [
    {
      "files": ["docs/**/*.md"],
      "options": {
        "proseWrap": "preserve",
        "embeddedLanguageFormatting": "auto",
      },
    },
  ],
}
