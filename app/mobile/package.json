{
  "name": "@freeanima/app-mobile",
  "description": "FreeAnima 移动端壳（Capacitor + 聊天室 chat）",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:debug": "MOBILE_DEBUG=1 vite build --mode development",
    "sync": "vite build && bunx cap sync android",
    "sync:debug": "MOBILE_DEBUG=1 vite build --mode development && bunx cap sync android",
    "android": "bash scripts/run-android.sh",
    "android:debug": "MOBILE_DEBUG=1 bash scripts/run-android.sh",
    "android:apk": "bash scripts/build-apk.sh",
    "android:install": "bash scripts/install-apk.sh",
    "android:open": "bash -lc 'source scripts/android-env.sh && bunx cap open android'",
    "setup:sdk": "bash scripts/setup-android-sdk.sh"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/keyboard": "^7.0.1",
    "@capacitor/preferences": "^7.0.1",
    "@freeanima/sap-contract": "workspace:*",
    "@freeanima/shell-sdk": "workspace:*",
    "@freeanima/shell-ui": "workspace:*",
    "vconsole": "^3.15.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
