{
  "extends": "../../tsconfig.composite.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": ".tsout",
    "paths": {
      "@chat/*": ["./ui/app/src/*"]
    }
  },
  "include": [
    "plugin.ts",
    "hub/**/*.ts",
    "protocol/**/*.ts",
    "ui/app/index.ts",
    "ui/app/src/**/*.ts",
    "ui/app/src/**/*.tsx",
    "../../types/**/*.d.ts"
  ],
  "exclude": ["**/*.test.ts", "dist/**"],
  "references": [{ "path": "../../frontend/ui-kit" }, { "path": "../../shared/sap-contract" }]
}
