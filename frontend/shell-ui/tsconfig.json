{
  "extends": "../../tsconfig.composite.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": ".tsout",
    "paths": {
      "@/*": ["../../satellites/companion/app/src/*", "./app/src/*"],
      "@shared/*": ["../../satellites/companion/shared/*"]
    }
  },
  "include": [
    "app/src/**/*.ts",
    "app/src/**/*.tsx",
    "src/**/*.ts",
    "types/**/*.d.ts",
    "build.ts",
    "../../types/**/*.d.ts"
  ],
  "exclude": ["dist/**"]
}
