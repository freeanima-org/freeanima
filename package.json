{
  "name": "freeanima",
  "version": "0.5.0",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@inlang/plugin-m-function-matcher": "^2.2.6",
    "@inlang/plugin-message-format": "^4.4.0",
    "@splicemood/lcov-to-cobertura": "^0.1.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.1",
    "@typescript/native-preview": "^7.0.0-dev.20260608.1",
    "bun-plugin-tailwind": "^0.1.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.69.0"
  },
  "bin": {
    "anima": "./cli/src/cli.ts"
  },
  "description": "逸灵风 Free Anima (TypeScript)",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run dep-check && bun run format && bun run test:changed",
    "dep-check": "bun scripts/check-layer-deps.ts && bun scripts/check-package-cycles.ts && bun scripts/check-no-db-execute.ts",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "bunx tsgo -p tsconfig.json --noEmit && bunx tsgo -p satellites/pair-programming/tsconfig.json --noEmit && bunx tsgo -p satellites/parlor/tsconfig.json --noEmit",
    "build:cli": "bun scripts/build-cli.ts",
    "build:webui": "bun scripts/build-webui.ts",
    "publish:cli": "bun scripts/build-cli.ts && cd cli/publish && bun pm pack && bun publish --access public",
    "test": "bun scripts/run-all-tests.ts",
    "test:unit": "bun scripts/run-unit-tests.ts",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "test:changed": "bun scripts/run-unit-tests.ts --changed",
    "paraglide:compile": "cd site && bun run paraglide",
    "i18n:po4a": "bun scripts/i18n-po4a.ts",
    "i18n:messages:master": "bun scripts/gen-messages-po4a-master.ts",
    "i18n:messages:compile": "bun scripts/compile-messages-from-po4a.ts",
    "i18n:messages:bootstrap-po": "bun scripts/bootstrap-messages-po.ts",
    "i18n:docs:cfg": "bun scripts/gen-po4a-cfg.ts",
    "i18n:docs:migrate-layout": "bun scripts/migrate-docs-po-layout.ts",
    "docs:check-frontmatter": "bun scripts/check-docs-frontmatter.ts",
    "i18n:docs:check": "bun scripts/check-po-health.ts",
    "i18n:docs:check:strict": "bun scripts/check-po-health.ts --strict",
    "memory:sample": "bun scripts/memory-sample.ts",
    "test:coverage": "bun test --coverage --pass-with-no-tests",
    "coverage:cobertura": "bun scripts/run-tests.ts --coverage && bun scripts/lcov-to-cobertura.ts",
    "coverage:check-threshold": "bun scripts/check-coverage-threshold.ts",
    "service": "bun cli/src/cli.ts service",
    "anima": "bun cli/src/cli.ts",
    "link:global": "mkdir -p \"${BUN_INSTALL:-$HOME/.bun}/bin\" && ln -sf \"$PWD/cli/src/cli.ts\" \"${BUN_INSTALL:-$HOME/.bun}/bin/anima\" && chmod +x cli/src/cli.ts",
    "prepare": "husky"
  },
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.3": "patches/drizzle-orm@1.0.0-rc.3.patch"
  },
  "trustedDependencies": [
    "cpu-features",
    "esbuild",
    "protobufjs"
  ],
  "workspaces": {
    "packages": [
      "kernel",
      "packages/*",
      "capabilities/*",
      "satellites/*",
      "cli",
      "site",
      "tests",
      "runtime",
      "core",
      "platform"
    ],
    "catalog": {
      "@types/node": "^24.12.4",
      "@typescript/native-preview": "^7.0.0-dev.20260602.1",
      "@types/bun": "^1.3.14",
      "drizzle-kit": "^1.0.0-rc.3",
      "drizzle-orm": "^1.0.0-rc.3",
      "typescript": "^5.9.3",
      "zod": "^4.4.3"
    }
  }
}
