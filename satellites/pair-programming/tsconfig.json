{
  "extends": "../../tsconfig.composite.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": ".tsout",
    "paths": {
      "@pair/*": ["./app/src/*"]
    }
  },
  "references": [{ "path": "../../frontend/shell-ui/vite" }],
  "include": [
    "app/src/**/*.ts",
    "app/src/**/*.tsx",
    "server/**/*.ts",
    "build.ts",
    "vite.config.ts",
    "../../types/**/*.d.ts"
  ]
}
