{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["bun"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist-types",
    "rootDir": ".",
    "allowImportingTsExtensions": false
  },
  "include": ["./**/*.ts", "../../types/**/*.d.ts"],
  "exclude": ["**/dist/**", "**/dist-types/**", "**/node_modules/**", "**/src-tauri/**"],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
