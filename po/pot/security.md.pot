#. type: Plain text
#: docs/security.md:122
msgid "## First-Deployment Security Checklist"
msgstr ""

#. type: Bullet: '1. '
#: docs/security.md:129
msgid "Install and initialize pass + GPG; all secrets into pass only"
msgstr ""

#. type: Bullet: '2. '
#: docs/security.md:129
msgid ""
"Copy [`config.example.yaml`](../config.example.yaml) → `~/.anima/"
"config.yaml`; **do not** write plaintext secrets in config"
msgstr ""

#. type: Bullet: '3. '
#: docs/security.md:129
msgid "`chmod 700 ~/.anima`"
msgstr ""

#. type: Bullet: '4. '
#: docs/security.md:129
msgid "Bind `127.0.0.1` only, or ensure intranet isolation"
msgstr ""

#. type: Bullet: '5. '
#: docs/security.md:129
msgid ""
"Review `mcp_servers` / `acp_agents` config; set `enabled: false` for "
"untrusted external Servers"
msgstr ""

#. type: Bullet: '6. '
#: docs/security.md:129
msgid "Regularly backup pass and `~/.anima/`; encrypt backup media"
msgstr ""

#. type: Bullet: '7. '
#: docs/security.md:129
msgid "Do not commit `.env`, `config.yaml` to git"
msgstr ""
