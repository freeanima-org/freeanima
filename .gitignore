# Environment
.env
.env.*
!.env.example

# Local runtime config (never commit)
config.yaml
*.local.yaml

# TypeScript composite emit（声明应落在 .tsout/，勿提交源码旁产物）
**/*.d.ts.map
**/*.d.ts
!types/**/*.d.ts
!**/global.d.ts
!packages/shell-ui/types/**/*.d.ts

# Cryptographic keys
*.pem
*.key
id_rsa
id_ed25519

# OS
.DS_Store
Thumbs.db

# IDE
# .vscode/
.idea/

# Cursor worktrees (created by cursor_agent tool)
/tmp/cursor-*/

# Node.js / Bun
node_modules/
.pnpm-store/
.turbo/
**/dist/
**/*.tsbuildinfo
**/.tsout/
pnpm-debug.log*
bun-debug.log*

# Admin Vue projects
connectors/admin/app/*/node_modules/
connectors/admin/app/dist/

# CLI publish 产物
cli/publish/

# Coverage
coverage/
.coverage-shards/

.tanstack/

# po4a / gettext
site/i18n/.generated/
docs/.generated/
docs/.zh-cn-ref/
messages/.generated/
messages/.zh-cn-ref/
gettextization.failed.po
*.mo



# Misc
/tmp/
