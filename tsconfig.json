{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./connectors/webui/app/src/*"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "kernel/**/*.ts",
    "storage/**/*.ts",
    "mechanism/**/*.ts",
    "orchestration/**/*.ts",
    "service/**/*.ts",
    "capabilities/**/*.ts",
    "connectors/**/*.ts",
    "cli/**/*.ts",
    "connectors/webui/app/**/*.ts",
    "connectors/webui/app/**/*.tsx",
    "connectors/webui/app/index.html",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/.turbo/**", "cli/publish/**"]
}
