{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["typescript", "oxc", "import", "unicorn"],
  "jsPlugins": ["./scripts/oxlint-plugins/freeanima/index.ts", "bun-plugin-dir-import/oxlint"],
  "env": {
    "node": true
  },
  "globals": {
    "Bun": "readonly"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/www/**",
    "packages/frontend/features/habitat/ui/habitat/routes/routeTree.gen.ts",
    "packages/frontend/portal/extension/**"
  ],
  "rules": {
    "dir-import/dir-import-exists": "error",
    "freeanima/import-depth": "error",
    "freeanima/layer-deps": "error",
    "freeanima/no-direct-offline-cache": "error",
    "freeanima/no-direct-chat": "error",
    "freeanima/pg-sql-array-bind": "error",
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true
      }
    ],
    "typescript/no-unused-vars": "off",
    "react/react-in-jsx-scope": "off",
    "unicorn/no-useless-spread": "error",
    "unicorn/consistent-function-scoping": "error",
    "eslint/no-control-regex": "off",
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allowAfterThis": true,
        "allow": [
          "__freeanimaShellBridge",
          "__freeanimaShellBootError",
          "__freeanimaWebUiConfig",
          "__WEB_DEFAULT_HABITAT_URL__",
          "__NATIVE_BUILD_META__",
          "__FREEANIMA_SHELL_TARGET__",
          "__FREEANIMA_NATIVE_BUILD_META__",
          "__TAURI_INTERNALS__",
          "__TAURI__",
          "_check",
          "_exhaustive",
          "_def",
          "_unsubscribe",
          "_streamGeneration",
          "_resetWeixinSessionPauseForTest",
          "_ensureBuiltinSleepCycleCronJob",
          "_ensureBuiltinTaskRemindersCronJob",
          "_title",
          "_removed"
        ]
      }
    ],
    "eslint/no-useless-constructor": "error",
    "eslint/no-unmodified-loop-condition": "error",
    "import/no-unassigned-import": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/prefer-add-event-listener": "error",
    "eslint/eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "eslint/no-promise-executor-return": "error",
    "unicorn/explicit-length-check": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "unicorn/prefer-node-protocol": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-conversion": "error",
    "typescript/consistent-return": "error",
    "typescript/no-meaningless-void-operator": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    "typescript/no-misused-spread": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/unbound-method": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error"
  },
  "overrides": [
    {
      "files": ["packages/frontend/features/habitat/ui/habitat/**/*.{ts,tsx}"],
      "plugins": ["react"],
      "env": {
        "browser": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/no-unstable-nested-components": "off",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn"
      }
    },
    {
      "files": ["packages/frontend/features/companion/**/*.{ts,tsx}"],
      "plugins": ["react"],
      "env": {
        "browser": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/no-unstable-nested-components": "off",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn"
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "env": {
        "jest": true
      },
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-floating-promises": "off",
        "typescript/await-thenable": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["scripts/archive/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["**/routeTree.gen.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["scripts/archive/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
