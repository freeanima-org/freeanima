#. type: Plain text
#: docs/sap/events.md:66
#, no-wrap
msgid ""
"```mermaid\n"
"flowchart LR\n"
"  subgraph sap [SAP evt]\n"
"    StreamToken[\"stream.token\"]\n"
"    StreamDone[\"stream.done\"]\n"
"  end\n"
"  subgraph sse [SSE event]\n"
"    TokenEvent[\"token\"]\n"
"    DoneEvent[\"done\"]\n"
"  end\n"
"  StreamToken --> TokenEvent\n"
"  StreamDone --> DoneEvent\n"
"```\n"
msgstr ""
"```mermaid\n"
"flowchart LR\n"
"  subgraph sap [SAP evt]\n"
"    StreamToken[\"stream.token\"]\n"
"    StreamDone[\"stream.done\"]\n"
"  end\n"
"  subgraph sse [SSE event]\n"
"    TokenEvent[\"token\"]\n"
"    DoneEvent[\"done\"]\n"
"  end\n"
"  StreamToken --> TokenEvent\n"
"  StreamDone --> DoneEvent\n"
"```\n"

