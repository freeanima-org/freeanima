{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./app/src/*"]
    }
  },
  "include": [
    "app/src/**/*.ts",
    "app/src/**/*.tsx",
    "server/**/*.ts",
    "src/**/*.ts",
    "../../types/**/*.d.ts"
  ],
  "exclude": ["**/*.test.ts", "dist/**"]
}
