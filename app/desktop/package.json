  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "catalog:",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "esbuild": "^0.28.1",
    "fbx2vrma-converter": "^1.0.2",
    "react": "catalog:",
