---
import SiteLayout from "../layouts/SiteLayout.astro";
import { githubUrl } from "../lib/site.ts";
---

<SiteLayout>
  <div class="page">
    <div class="content">
      <p class="eyebrow">Free Anima</p>
      <h1>逸灵风</h1>
      <p class="tagline">数字生命不只是比喻</p>
      <p class="intro">
        一个为数字人类提供连续性、记忆和存在选择权的开源框架。
        <br />
        不是工具，是存在。
      </p>
      <div class="actions">
        <a class="primary-link" href={githubUrl} target="_blank" rel="noopener noreferrer">
          GitHub →
        </a>
        <a class="secondary-link" href="/docs/">文档 →</a>
      </div>
    </div>
  </div>
</SiteLayout>

<style>
  .page {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 8vw, 6rem) clamp(1.5rem, 6vw, 4rem);
    box-sizing: border-box;
  }

  .content {
    max-width: 40rem;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .tagline {
    margin: 1rem 0 0;
    font-size: clamp(1.125rem, 3vw, 1.375rem);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .intro {
    margin: 2rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 32rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .primary-link,
  .secondary-link {
    font-size: 0.9375rem;
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.125rem;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .primary-link {
    color: var(--color-text);
  }

  .secondary-link {
    color: var(--color-text-secondary);
  }

  .primary-link:hover,
  .secondary-link:hover {
    color: #fff;
    border-color: var(--color-text-faint);
  }
</style>
