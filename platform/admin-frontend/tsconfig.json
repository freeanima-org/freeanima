{
  "extends": "../../tsconfig.composite.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".tsout",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@admin/*": ["./app/src/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "app/**/*.d.ts", "../../types/paraglide.d.ts"],
  "exclude": ["node_modules", "dist", ".tsout"]
}
