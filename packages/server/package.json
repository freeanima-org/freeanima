{
  "name": "@freeanima/legacy-server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./alive": {
      "types": "./dist/alive.d.ts",
      "import": "./dist/alive.js"
    },
    "./bind-hosts": {
      "types": "./dist/bind-hosts.d.ts",
      "import": "./dist/bind-hosts.js"
    },
    "./api": {
      "types": "./dist/api-types.d.ts",
      "import": "./dist/api-types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration --passWithNoTests"
  },
  "dependencies": {
    "@freeanima/legacy-api": "workspace:*",
    "@freeanima/legacy-db": "workspace:*",
    "@freeanima/legacy-clarify": "workspace:*",
    "@freeanima/legacy-engine": "workspace:*",
    "@freeanima/legacy-gateway": "workspace:*",
    "@freeanima/legacy-integrations": "workspace:*",
    "@freeanima/legacy-kernel": "workspace:*",
    "@freeanima/legacy-memory": "workspace:*",
    "@freeanima/legacy-runtime": "workspace:*",
    "@freeanima/legacy-tools": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.8.0",
    "hono": "^4.12.23",
    "zod": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
