{
  "name": "@freeanima/satellite-companion",
  "description": "FreeAnima 桌面伴侣（Electron）",
  "author": "FreeAnima",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron-dist/main.js",
  "scripts": {
    "postinstall": "bun scripts/ensure-fbx2gltf.ts",
    "setup:fbx": "bun scripts/ensure-fbx2gltf.ts --strict",
    "dev": "bun dev.ts",
    "dev:electron": "bun dev-electron.ts",
    "build": "bun build.ts",
    "build:electron": "bun build-electron.ts",
    "build:windows": "bun build-electron.ts --platform win",
    "build:windows:installer": "COMPANION_BUILD_PROFILE=release bun build-electron.ts --platform win",
    "build:macos": "bun build-electron.ts --platform mac",
    "build:macos:intel": "COMPANION_BUILD_PROFILE=release bun build-electron.ts --platform mac",
    "build:macos:release": "COMPANION_BUILD_PROFILE=release bun build-electron.ts --platform mac",
    "build:macos:intel:release": "COMPANION_BUILD_PROFILE=release bun build-electron.ts --platform mac",
    "start": "bun build.ts && bun server/index.ts"
  },
  "dependencies": {
    "@freeanima/sap-contract": "workspace:*",
    "@pixiv/three-vrm": "^3.4.2",
    "@pixiv/three-vrm-animation": "^3.4.2",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "fbx2vrma-converter": "^1.0.2",
    "react": "19",
    "react-dom": "19",
    "three": "^0.175.0",
    "ws": "^8.18.3",
    "zod": "catalog:",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.175.0",
    "@types/ws": "^8.18.1",
    "bun-plugin-tailwind": "^0.1.2",
    "daisyui": "^5.5.20",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.5",
    "tailwindcss": "^4.3.0"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
