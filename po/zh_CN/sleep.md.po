msgstr "消息1 是 token 消耗大头且线性增长，保持不变以最大化 provider 缓存。"

#. type: Plain text
#: docs/concepts/sleep.md:127
msgid "### Message 1.5 Format"
msgstr "### 消息1.5 格式"

#. type: Plain text
#: docs/concepts/sleep.md:130
