msgid "First-Deployment Security Checklist"
msgstr ""

#. type: Bullet: '1. '
#: docs/guide/security.md:141
msgid ""
"Copy [`config.example.yaml`](../../config.example.yaml) → `~/.anima/"
"config.yaml`; use `vault()` / `env()` — **do not** write plaintext secrets "
"in config"
msgstr ""

#. type: Bullet: '2. '
#: docs/guide/security.md:141
msgid ""
"Open Shell `/vault`; set User master password; migrate secrets from legacy "
"pass if needed"
msgstr ""

#. type: Bullet: '3. '
#: docs/guide/security.md:141
msgid "`chmod 700 ~/.anima` (includes `vault/agent-machine.key`)"
msgstr ""

#. type: Bullet: '4. '
#: docs/guide/security.md:141
msgid "Bind `127.0.0.1` only, or ensure intranet isolation"
msgstr ""

#. type: Bullet: '5. '
#: docs/guide/security.md:141
msgid ""
"Review `mcp_servers` / `acp_agents` config; set `enabled: false` for "
"untrusted external Servers"
msgstr ""

#. type: Bullet: '6. '
#: docs/guide/security.md:141
msgid ""
"Regularly backup `~/.anima/` (and legacy `~/.password-store` if kept); "
"encrypt backup media"
msgstr ""

#. type: Bullet: '7. '
#: docs/guide/security.md:141
msgid "Do not commit `.env`, `config.yaml` to git"
msgstr ""
