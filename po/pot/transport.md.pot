#: docs/sap/transport.md:116
#, no-wrap
msgid "RPC errors"
msgstr ""

#. type: Plain text
#: docs/sap/transport.md:119
msgid "Failed RPCs return `res` with `ok: false` and:"
msgstr ""

#. type: Fenced code block (json)
#: docs/sap/transport.md:120
#, no-wrap
msgid "{ \"code\": \"sap_error\", \"message\": \"...\" }\n"
msgstr ""

