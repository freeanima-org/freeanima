---
import { m } from "../lib/i18n.ts";
import {
  detectLocale,
  getLanguageSwitch,
  getNavLinks,
  siteName,
  type SiteLocale,
} from "../lib/site.ts";

interface Props {
  embedded?: boolean;
  locale?: SiteLocale;
}

const { embedded = false, locale: localeProp } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const locale = localeProp ?? detectLocale(pathname);
const navLinks = getNavLinks(locale);
const languageSwitch = getLanguageSwitch(pathname);

function isActive(href: string): boolean {
  if (href === "/" || href === "/zh-cn/") {
    return pathname === href.replace(/\/$/, "") || pathname === href;
  }
  if (href.startsWith("/docs")) {
    return pathname === "/docs" || pathname.startsWith("/docs/");
  }
  return false;
}
---

<header class:list={["site-header", embedded && "site-header--embedded"]}>
  <div class="site-header__inner">
    <a class="site-header__brand" href={locale === "zh-cn" ? "/zh-cn/" : "/"}>
      {siteName}
    </a>
    <nav class="site-header__nav" aria-label={m.nav_site_aria()}>
      {
        navLinks.map((link) => (
          <a
            class:list={["site-header__link", isActive(link.href) && "site-header__link--active"]}
            href={link.href}
            target={"external" in link && link.external ? "_blank" : undefined}
            rel={"external" in link && link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="site-header__link site-header__link--locale" href={languageSwitch.href}>
        {languageSwitch.label}
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 0.875rem clamp(1.25rem, 4vw, 2rem);
  }

  .site-header__brand {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }

  .site-header__brand:hover {
    color: #fff;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.25rem 1.25rem;
  }

  .site-header__link {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .site-header__link:hover,
  .site-header__link--active {
    color: var(--color-text);
  }

  .site-header__link--locale {
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    padding: 0.125rem 0.5rem;
  }

  @media (max-width: 480px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-header__nav {
      justify-content: flex-start;
    }
  }
</style>
