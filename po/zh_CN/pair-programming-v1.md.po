#. type: Plain text
#: docs/designs/pair-programming-v1.md:53
msgid "## I. Platform-Aware Sessions"
msgstr "## 一、Platform 感知的会话"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:55
msgid "### Change: Frontend API Client"
msgstr "### 改动：前端 API client"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:61
#, no-wrap
msgid ""
"```ts\n"
"// api/client.ts\n"
"export function createSession(platform = \"parlor\") {\n"
"  return postJSON(\"/sessions\", { platform });\n"
"}\n"
msgstr ""
"```ts\n"
"// api/client.ts\n"
"export function createSession(platform = \"parlor\") {\n"
"  return postJSON(\"/sessions\", { platform });\n"
"}\n"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:67
#, no-wrap
msgid ""
"export function listSessions(platform?: string) {\n"
"  const q = platform ? `?platform=${encodeURIComponent(platform)}` : \"\";\n"
"  return getJSON(`/sessions${q}`).then((d) => d.sessions || []);\n"
"}\n"
"```\n"
msgstr ""
"export function listSessions(platform?: string) {\n"
"  const q = platform ? `?platform=${encodeURIComponent(platform)}` : \"\";\n"
"  return getJSON(`/sessions${q}`).then((d) => d.sessions || []);\n"
"}\n"
"```\n"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:69
msgid "### Change: Backend HTTP Layer"
msgstr "### 改动：后端 HTTP 层"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:72
msgid "```ts // http-app.ts"
msgstr "```ts // http-app.ts"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:79
#, no-wrap
msgid ""
"// Create session — read platform from body\n"
"api.post(\"/sessions\", async (c) => {\n"
"  const body = await c.req.json().catch(() => ({}));\n"
"  const platform = body.platform ?? PARLOR_PLATFORM;\n"
"  return c.json(service.createSession(platform));\n"
"});\n"
msgstr ""
"// 创建会话 — 从 body 读取 platform\n"
"api.post(\"/sessions\", async (c) => {\n"
"  const body = await c.req.json().catch(() => ({}));\n"
"  const platform = body.platform ?? PARLOR_PLATFORM;\n"
"  return c.json(service.createSession(platform));\n"
"});\n"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:86
#, no-wrap
msgid ""
"// List sessions — optional platform filter\n"
"api.get(\"/sessions\", (c) => {\n"
"  const platform = c.req.query(\"platform\") ?? undefined;\n"
"  return c.json(service.listSessions(platform));\n"
"});\n"
"```\n"
msgstr ""
"// 列出会话 — 可选 platform 过滤\n"
"api.get(\"/sessions\", (c) => {\n"
"  const platform = c.req.query(\"platform\") ?? undefined;\n"
"  return c.json(service.listSessions(platform));\n"
"});\n"
"```\n"

#. type: Plain text
#: docs/designs/pair-programming-v1.md:88
msgid ""
"> Note: `conversation.ts` `newSession(platform)` and "
"`listSessions(platform?)` already support platform; HTTP layer only needs "
"passthrough."
msgstr ""
"> 注意：`conversation.ts` 中的 `newSession(platform)` 和 "
"`listSessions(platform?)` 已支持 platform，只需 HTTP 层透传。"

#. type: Plain text
