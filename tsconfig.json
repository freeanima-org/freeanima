{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./platform/connectors/webui/app/src/*"],
      "@freeanima/sap-contract": ["./packages/sap-contract/src/index.ts"],
      "@freeanima/capabilities-satellite": ["./capabilities/satellite/src/index.ts"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "kernel/**/*.ts",
    "packages/**/*.ts",
    "core/**/*.ts",
    "runtime/**/*.ts",
    "platform/**/*.ts",
    "capabilities/**/*.ts",
    "satellites/**/*.ts",
    "cli/**/*.ts",
    "platform/connectors/webui/app/**/*.ts",
    "platform/connectors/webui/app/**/*.tsx",
    "platform/connectors/webui/app/index.html",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/.turbo/**",
    "cli/publish/**",
    "satellites/pair-programming/app/**",
    "satellites/parlor/app/**",
    "satellites/companion/app/**"
  ]
}
