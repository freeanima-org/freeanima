{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "build.ts",
    "dev.ts",
    "dev-electron.ts",
    "build-electron.ts",
    "scripts/**/*.ts",
    "app/src/**/*.test.ts",
    "server/**/*.test.ts",
    "src/shared/**/*.test.ts"
  ],
  "exclude": ["electron-dist/**", "release/**"]
}
