# Environment
.env
.env.*
!.env.example

# direnv / nix develop 本地缓存
.direnv/

# Local runtime config (never commit)
config.yaml
*.local.yaml

# TypeScript composite emit（声明应落在 .tsout/，勿提交源码旁产物）
**/*.d.ts.map
**/*.d.ts
!types/**/*.d.ts
!**/global.d.ts
!**/env.d.ts
!packages/shell-ui/types/**/*.d.ts

# Cryptographic keys
*.pem
*.key
id_rsa
id_ed25519

# OS
.DS_Store
Thumbs.db

# IDE
# .vscode/
.idea/

# Cursor worktrees (created by cursor_agent tool)
/tmp/cursor-*/

# Node.js / Bun
node_modules
.pnpm-store/
.turbo/
**/dist/
# web dist 目录须在仓内（仅占位 .gitignore），供 dir: + oxlint dir-import-exists
!packages/frontend/portal/app/web/dist/
!packages/frontend/portal/app/web/dist/.gitignore
**/dist-desktop/
**/dist-mobile/
**/*.tsbuildinfo
**/.tsout/
pnpm-debug.log*
bun-debug.log*

# Admin Vue projects
connectors/admin/app/*/node_modules/
connectors/admin/app/dist/

# Coverage
coverage/
.coverage-shards/

.tanstack/
.wxt/

# LoCoMo eval cache / reports（风巢 #16041）
.cache/locomo/
scripts/eval/locomo/out/

# Misc
/tmp/

# Tauri
**/src-tauri/target/
**/src-tauri/companion-dist/
**/src-tauri/ui/
**/src-tauri/gen/
**/src-tauri/tauri.conf.identity.generated.json
dist-types/
**/dist-float/
