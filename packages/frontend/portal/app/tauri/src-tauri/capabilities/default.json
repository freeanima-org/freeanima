{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "FreeAnima desktop shell capabilities",
  "windows": ["main", "companion", "coding", "pomodoro-float"],
  "remote": {
    "urls": [
      "http://127.0.0.1:5000/*",
      "http://localhost:5000/*",
      "http://127.0.0.1:4176/*",
      "http://localhost:4176/*",
      "http://127.0.0.1:4186/*",
      "http://localhost:4186/*",
      "http://127.0.0.1:4196/*",
      "http://localhost:4196/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:event:default",
    "core:tray:default",
    "store:default",
    "notification:default",
    "apk-installer:default",
    "blob-saver:default",
    "autostart:default",
    "shell:allow-open",
    "allow-get-habitat-config",
    "allow-set-habitat-config",
    "allow-open-settings",
    "allow-set-pomodoro-widget-state",
    "allow-get-pomodoro-widget-state",
    "allow-set-click-through",
    "allow-set-pointer-active",
    "allow-move-companion-window",
    "allow-get-companion-position",
    "allow-get-patrol-screen",
    "allow-get-cursor-position",
    "allow-start-companion-drag",
    "allow-get-companion-visible",
    "allow-set-companion-visible",
    "allow-get-coding-visible",
    "allow-set-coding-visible",
    "allow-get-pomodoro-float-visible",
    "allow-set-pomodoro-float-visible",
    "allow-open-pomodoro",
    "allow-report-remote-tools-status",
    "allow-get-remote-tools-status",
    "allow-report-companion-model-status",
    "allow-get-companion-model-status",
    "allow-show-native-alert",
    "allow-read-native-alert-permission",
    "allow-request-native-alert-permission",
    "allow-set-app-badge-count",
    "allow-request-app-attention",
    "allow-clear-app-attention",
    "allow-instance-load",
    "allow-instance-save",
    "allow-probe-habitat-health",
    "allow-apply-packaged-update",
    "allow-pick-directory",
    "allow-save-blob",
    "allow-workspace-fs-list-dir",
    "allow-workspace-fs-read-text",
    "allow-workspace-fs-write-text",
    "allow-workspace-fs-exists",
    "allow-workspace-fs-is-dir",
    "allow-workspace-fs-walk-files",
    "allow-workspace-fs-search",
    "allow-run-command"
  ]
}
