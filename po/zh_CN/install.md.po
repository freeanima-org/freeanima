msgstr ""

#. type: Fenced code block (bash)
#: docs/guide/install.md:52
#, no-wrap
msgid ""
"curl -fsSL https://freeanima.com/install | PROXY=ghproxy-net bash\n"
"curl -fsSL https://freeanima.com/install | CHANNEL=canary PROXY=ghfast-top bash\n"
msgstr ""

#. type: Plain text
#: docs/guide/install.md:58
msgid ""
"可选环境变量：`FREEANIMA_INSTALL_PREFIX`（默认 `~/.anima/standalone`）、"
"`FREEANIMA_HOME`（默认 `~/.anima`，决定 `bin` shim 位置）。"
msgstr ""

#. type: Plain text
#: docs/guide/install.md:60
msgid "备用（不依赖站点发布）："
msgstr ""

#. type: Fenced code block (bash)
#: docs/guide/install.md:61
#, fuzzy, no-wrap
#| msgid ""
#| "git clone https://github.com/freeanima-org/freeanima.git\n"
#| "cd freeanima\n"
#| "bun install\n"
