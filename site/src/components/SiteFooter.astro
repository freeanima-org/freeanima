---
import { githubUrl, siteUrl } from "../lib/site.ts";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__copy">
      © {year}
      <a href={siteUrl}>freeanima.com</a>
    </p>
    <a class="site-footer__link" href={githubUrl} target="_blank" rel="noopener noreferrer">
      GitHub
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    max-width: 72rem;
    margin-inline: auto;
    padding: 1.25rem clamp(1.25rem, 4vw, 2rem);
    font-size: 0.8125rem;
    color: var(--color-text-dim);
  }

  .site-footer__copy {
    margin: 0;
  }

  .site-footer__copy a,
  .site-footer__link {
    color: inherit;
    text-decoration: none;
  }

  .site-footer__copy a:hover,
  .site-footer__link:hover {
    color: var(--color-text-faint);
  }
</style>
